enum {
    PERF_VT = 56,
    LDR_VT = 16,
    SEG_VT = 32, /* IUnknown + Segment(23) + Segment8(5) = 31 slots used */
    PATH_VT = 16,
    STATE_VT = 10, /* SegmentState8: QI..GetObjectInPath */
    PERF_IDX_STOP = 5,        /* +0x14 Stop(seg,state,time,flags) */
    PERF_IDX_SETNOTIF = 20,   /* +0x50 */
    PERF_IDX_GETNOTIF = 21,   /* +0x54 */
    PERF_IDX_ADDNOTIF = 22,   /* +0x58 */
    PERF_IDX_FREEPMSG = 17,   /* +0x44 FreePMsg — notification thread */
    PERF_IDX_SETGLOBAL = 34,  /* +0x88 */
    PERF_IDX_CLOSEDOWN = 38,  /* +0x98 */
    PERF_IDX_INITAUDIO = 44,  /* +0xB0 */
    PERF_IDX_PLAYSEGEX = 45,  /* +0xB4 */
    PERF_IDX_STOPEX = 46,     /* +0xB8 StopEx */
    PERF_IDX_CREATESTD = 49,  /* +0xC4 */
    LDR_IDX_GETOBJECT = 3,
    LDR_IDX_SETOBJECT = 4,
    LDR_IDX_SETSEARCH = 5,
    LDR_IDX_SCANDIR = 6,
    LDR_IDX_CACHEOBJ = 7,
    LDR_IDX_RELEASEOBJ = 8, /* +0x20 ReleaseObject(IUnknown*) */
    LDR_IDX_CLEARCACHE = 9,
    LDR_IDX_ENABLECACHE = 10,
    LDR_IDX_COLLECTGARBAGE = 11, /* +0x2C Loader8 */
    /* ba50 calls loader[+0x34]=slot13 after SEGEND — must be ret@8 not @16 (H52) */
    SEG_IDX_DOWNLOAD = 29, /* Segment8::Download */
    SEG_IDX_UNLOAD = 30,
};

enum {
    DMUS_OBJ_CLASS = 0x001,
    DMUS_OBJ_STREAM = 0x800
};

/* Minimal DMUS notification (game thread @ 0x40C860 waits on SEGEND). */
static const GUID CK_GUID_NOTIFICATION_SEGMENT = {
    0xd2ac2899, 0xb39b, 0x11d1, {0x87, 0x04, 0x00, 0x60, 0x08, 0x93, 0xb1, 0xbd}};
#define CK_DMUS_PMSGT_NOTIFICATION 3u
#define CK_DMUS_NOTIFICATION_SEGEND 1u
#define CK_NOTIF_SLOTS 32

typedef struct IStreamVtbl_mini {
    HRESULT(STDMETHODCALLTYPE *QueryInterface)(void *, REFIID, void **);
    ULONG(STDMETHODCALLTYPE *AddRef)(void *);
    ULONG(STDMETHODCALLTYPE *Release)(void *);
    HRESULT(STDMETHODCALLTYPE *Read)(void *, void *, ULONG, ULONG *);
    HRESULT(STDMETHODCALLTYPE *Write)(void *, const void *, ULONG, ULONG *);
    HRESULT(STDMETHODCALLTYPE *Seek)(void *, LARGE_INTEGER, DWORD, ULARGE_INTEGER *);
} IStreamVtbl_mini;

/* Game Sound wrapper (separate object) holds segment* at +4 and path at +0x10.
 * Our segment is a normal COM object: vtbl + refs + payload. */
typedef struct {
    void **lpVtbl; /* +0x00 */
    LONG refs;     /* +0x04 */
    BYTE *pcm;
    DWORD pcm_bytes;
    WAVEFORMATEX fmt;
    void *last_path;
    DWORD repeats; /* SetRepeats: 0=once, (DWORD)-1=infinite (game bool true) */
    char path[200];
} CkSegment;

typedef struct {
    void **lpVtbl; /* +0 */
    void *self;    /* +4 — game Download does *(audiopath+4); must be a pointer, not refs */
    LONG refs;     /* +8 */
    DWORD id;
    LPDIRECTSOUNDBUFFER ctrl; /* real DS secondary (PATH_BUFFER) */
    void *ctrl_proxy;         /* COM wrapper returned to game — intercepts SetPan */
    LONG vol;
    LONG pan; /* DSBPAN_LEFT..RIGHT; game SetPan via GetObjectInPath buffer */
} CkPath;

/* Proxy so game SetPan/SetVolume on PATH_BUFFER reach live SFX buffers. */
typedef struct {
    void **lpVtbl;
    LONG refs;
    CkPath *path;
    LPDIRECTSOUNDBUFFER real;
} CkDsCtrl;

typedef struct CkState CkState;
struct CkState {
    void **lpVtbl;   /* +0 */
    LONG refs;       /* +4 — native +4 is Graph vtbl (const); we only need GetSegment */
    CkSegment *seg;  /* +8 — returned by GetSegment → QI Segment8 */
    DWORD repeats;
};

/*
 * Native DMUS_NOTIFICATION_PMSG (game @0x40C860): type@0x28 punk@0x34 guid@0x38 opt@0x48.
 * Default GCC align pads after dwSize → type@0x2C — GUID mismatch, Unload never runs (H51).
 * Must pack(4) like DirectMusic headers (no pad before REFERENCE_TIME).
 */
#pragma pack(push, 4)
typedef struct {
    DWORD dwSize;
    LONGLONG rtTime;
    LONGLONG mtTime;
    DWORD dwFlags;
    DWORD dwPChannel;
    DWORD dwVirtualTrackID;
    void *pTool;
    void *pGraph;
    DWORD dwType;
    DWORD dwVoiceID;
    DWORD dwGroupID;
    void *punkUser;
    GUID guidNotificationType;
    DWORD dwNotificationOption;
    DWORD dwField1;
    DWORD dwField2;
} CkNotifMsg;
#pragma pack(pop)

typedef struct {
    unsigned char phase; /* 0=free 1=scheduled 2=delivered */
    DWORD fire_ms;
    CkNotifMsg msg;
    CkState *state;
} CkNotifSlot;

typedef struct {
    void **lpVtbl;
    LONG refs;
    LPDIRECTSOUND ds;
    LPDIRECTSOUNDBUFFER primary;
    LPDIRECTSOUNDBUFFER music_buf; /* looping BGM — never GC via sfx pool (H33) */
    HWND hwnd;
    CRITICAL_SECTION lock;
    HANDLE notif_event;
    int notif_segment;
    CkNotifSlot notif[CK_NOTIF_SLOTS];
} CkPerf;

typedef struct {
    void **lpVtbl;
    LONG refs;
} CkLoader;

