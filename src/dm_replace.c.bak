typedef struct {
    LPDIRECTSOUNDBUFFER b;  /* mono/stereo SFX, or L half for spatial voice */
    LPDIRECTSOUNDBUFFER bR; /* R half for spatial voice; NULL otherwise */
    DWORD done_tick;
    DWORD path_id;
